{
  "name": "jugahoyweb-backend",
  "version": "1.0.0",
  "description": "Backend API para plataforma de gestión de complejos deportivos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:prod": "node server.js",
    "migrate": "sequelize db:migrate",
    "migrate:undo": "sequelize db:migrate:undo",
    "migrate:undo:all": "sequelize db:migrate:undo:all",
    "migrate:status": "sequelize db:migrate:status",
    "seed:localidades": "node scripts/seed-localidades.js",
    "check:tokens": "node scripts/check-expiring-tokens.js",
    "test:gym": "node tests/gym.e2e.js",
    "test:torneos": "node tests/torneos-ligas.e2e.js",
    "test:torneos:migracion": "node tests/torneos-migracion.test.js",
    "test:torneos:puntajes": "node tests/torneos-puntajes.e2e.js",
    "test:torneos:siembra": "node tests/torneos-siembra.test.js",
    "test:ranking": "node tests/ranking-anual.e2e.js",
    "test:torneos:plantel": "node tests/torneos-plantel.e2e.js",
    "test:torneos:llave": "node tests/torneos-llave.e2e.js",
    "test:torneos:simulacion": "node tests/torneos-simulacion.e2e.js",
    "test:portal-jugador": "node tests/portal-jugador.e2e.js",
    "test:notificaciones": "node tests/notificaciones-push.e2e.js",
    "test:notificaciones:recarga": "node tests/notificaciones-recarga.e2e.js",
    "test:resultados": "node --test tests/resultados-validacion.test.js",
    "test:pay": "node --test --experimental-test-coverage --test-coverage-include=src/services/pay/liquidacion.js tests/pay-liquidacion.test.js",
    "test:pay:e2e": "node tests/pay.e2e.js",
    "test:resultados:e2e": "node tests/resultados-carga.e2e.js",
    "test:llaves": "node --test --experimental-test-coverage --test-coverage-include=src/services/brackets/*.js src/services/brackets/tests/*.test.js",
    "test:llaves:e2e": "node tests/llaves-oficiales.e2e.js",
    "test:llaves:borrar": "node tests/borrar-llave.e2e.js",
    "test:llaves:plantillas": "node tests/plantillas-llaves.e2e.js",
    "test:relampago": "node --test --experimental-test-coverage --test-coverage-include=src/services/torneos/formatoPartido.js tests/relampago-formato.test.js",
    "test:relampago:e2e": "node tests/relampago.e2e.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "axios": "^1.18.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "firebase-admin": "^12.7.0",
    "https-proxy-agent": "5.0.1",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.2.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.1",
    "nodemailer": "^9.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "9.14.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2"
  }
}
